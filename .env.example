APP_ENV=local
APP_URL=http://localhost:8080
DB_DRIVER=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sarzedo
DB_USERNAME=sarzedo
DB_PASSWORD=
PAYMENT_DRIVER=demo
ASAAS_ENV=sandbox
