INSTAGRAM_ADS_ENABLED=false
INSTAGRAM_IG_USER_ID=
INSTAGRAM_PAGE_ACCESS_TOKEN=
INSTAGRAM_GRAPH_VERSION=v26.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NOTIFICATIONS_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_WHATSAPP_FROM=
TWILIO_CONTENT_SID=

# Apenas para Docker Compose
MYSQL_ROOT_PASSWORD=

# Primeira versão: avisos enviados manualmente pelo administrador.
NOTIFICATION_MODE=manual
